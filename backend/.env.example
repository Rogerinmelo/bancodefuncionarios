APP_NAME=BNC Funcionarios API
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bnc_funcionarios
JWT_SECRET_KEY=trocar-esta-chave-em-producao
JWT_REFRESH_SECRET_KEY=trocar-refresh-chave-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

STORAGE_BUCKET=bnc-fotos
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_SSL=false
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp
SIGNED_URL_EXPIRES_SECONDS=3600
